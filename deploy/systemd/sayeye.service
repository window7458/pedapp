[Unit]
Description=SayEye 상시 서버 (127.0.0.1:8080, Tailscale Funnel 으로 공개)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@/code/app
ExecStart=/bin/bash @REPO@/deploy/sayeye.sh run-app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
